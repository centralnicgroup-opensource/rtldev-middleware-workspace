{
  "name": "rtldev-middleware-workspace",
  "description": "Workspace for bulk edits and cross-repository operations across the RTLDEV middleware repositories",
  "version": "0.0.0-development",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Kai Schwarz",
    "email": "kai.schwarz@centralnic.com"
  },
  "maintainers": [
    {
      "name": "Kai Schwarz",
      "email": "kai.schwarz@centralnic.com"
    },
    {
      "name": "Asif Nawaz",
      "email": "asif.nawaz@centralnic.com"
    }
  ],
  "homepage": "https://github.com/centralnicgroup-opensource/rtldev-middleware-workspace",
  "repository": "github:centralnicgroup-opensource/rtldev-middleware-workspace.git",
  "bugs": "https://github.com/centralnicgroup-opensource/rtldev-middleware-workspace/issues",
  "keywords": [
    "workspace",
    "monorepo",
    "submodules",
    "rtldev",
    "middleware"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "repo:settings": "bash scripts/repo-settings.sh",
    "repo:settings:apply": "bash scripts/repo-settings.sh --apply",
    "ws": "bash scripts/ws.sh",
    "ws:status": "bash scripts/ws.sh status",
    "ws:sync": "bash scripts/ws.sh sync",
    "ws:pull": "bash scripts/ws.sh pull",
    "ws:add": "bash scripts/ws.sh add"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
